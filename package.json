{
  "name": "campus-route",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed-campus.mjs",
    "labels": "node scripts/make-building-labels.mjs",
    "icons": "node scripts/make-icons.mjs",
    "font": "node scripts/make-font.mjs",
    "dev": "vite",
    "prebuild": "node scripts/make-font.mjs && node scripts/copy-ocr.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "ocr": "node scripts/copy-ocr.mjs"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.2",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/kor": "^1.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fontkit": "^2.0.4",
    "globals": "^17.7.0",
    "pretendard": "1.3.9",
    "prettier": "^3.9.6",
    "subset-font": "^2.7.0",
    "tesseract.js-core": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
